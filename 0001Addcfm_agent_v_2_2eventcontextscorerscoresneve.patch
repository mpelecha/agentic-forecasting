+"""Skill registration contract tests."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import yaml
+from energy_oil_forecasting.cfm_agent_v_2_2.config import SKILLS_ROOT
+
+
+EXPECTED = ["event-context-analysis"]
